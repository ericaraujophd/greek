{
  "name": "greek",
  "version": "0.1.0",
  "private": true,
  "description": "A study companion for Greek Fundamentals I at Calvin Theological Seminary, alongside Mounce, Basics of Biblical Greek.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,yellow \"vite\" \"tsx watch server/index.ts\"",
    "web": "vite",
    "api": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "build:data": "tsx scripts/build-data.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "VITE_API_URL=http://localhost:8788 vite build"
  },
  "dependencies": {
    "@fontsource/gentium-book-plus": "^5.2.0",
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "1.56.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.2"
  }
}
