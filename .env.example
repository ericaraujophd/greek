# Copy this file to .env (same folder) and fill it in. .env is git-ignored.
# Every setting is explained in server/env.ts.

# Neon: Dashboard > your project > Branches > "dev" > Connect > copy the
# connection string (it starts with postgresql:// and ends with sslmode=require).
# Use "pglite" for a throwaway in-memory database (nothing is saved).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# A long random string. Make one with:  openssl rand -base64 48
SESSION_SECRET=

# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=

ALLOWED_DOMAIN=calvinseminary.edu
ADMIN_EMAILS=efer251@calvinseminary.edu

# 1 = show "Developer sign-in" on the sign-in page (no Google needed).
# Handy on your Mac. Never set this on a public server.
DEV_LOGIN=1

WEB_ORIGIN=http://localhost:5173
PORT=8787
